APP_NAME="ТюмГУ Тесты"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ptp.localhost

LOG_CHANNEL=stack
# Журнал: single — один файл, daily — файл на каждый день (14 дней), для пилота и сервера
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ptp_diploma
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ИИ-агенты: fake — заготовки без нейросети, ответы генерируются шаблонами
AGENTS_DRIVER=fake
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=

# Путь к консольному php.exe: обработчик очереди из веб-запроса и учебная база SQL
# (запрос выполняется отдельным процессом и прерывается через SQL_SANDBOX_TIMEOUT секунд)
QUEUE_AUTOSTART_PHP=
SQL_SANDBOX_TIMEOUT=3
# Сколько обработчиков очереди и процессов учебной базы работают одновременно (пилот на 200 студентов)
QUEUE_MAX_WORKERS=3
# Виртуальный хостинг: обработчики запускает cron, а не сайт (docs/hosting.md). Тогда QUEUE_AUTOSTART_PHP
# пустой, SQL_SANDBOX_PHP — путь к консольному php, QUEUE_CRON_WORKERS — число строк queue:work в crontab
QUEUE_CRON_WORKERS=0
SQL_SANDBOX_PARALLEL=6
